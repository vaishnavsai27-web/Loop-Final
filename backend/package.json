{
  "name": "loop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js status",
    "db:verify": "node scripts/verify-db.js",
    "seed:generate": "node scripts/generate-seed.js",
    "admin:provision": "node scripts/provision-admin.js",
    "artist:scan": "node scripts/scan-artist-uploads.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:sql": "node scripts/sql-contract-check.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.11.4"
  },
  "engines": {
    "node": "26.x"
  },
  "description": "LOOP API \u2014 Express + MySQL"
}
